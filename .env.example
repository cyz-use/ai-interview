# =====================================================================
# AI 面试系统 v3.0 — 环境变量配置
# =====================================================================
# 使用方法: 复制为 .env 并填入实际的 API Key
#   cp .env.example .env
# =====================================================================

# ---------- LLM 大模型 ----------
# DeepSeek API（必填）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# ---------- 数据库 ----------
# 开发模式（默认 SQLite，无需安装额外服务）
DATABASE_URL=sqlite:///./interview.db
# 生产模式（Docker Compose 自动使用此配置）
# DATABASE_URL=postgresql://interview:interview@postgres:5432/interview_db

# ---------- Redis（可选，生产模式启用限流和异步任务）----------
# REDIS_URL=redis://localhost:6379/0

# ---------- MinIO 对象存储（可选，用于存储简历文件和语音）----------
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=interview-files

# ---------- JWT 认证 ----------
JWT_SECRET=change-me-to-a-random-string-in-production
# JWT_EXPIRE_MINUTES=1440

# ---------- RAG 知识库 ----------
# EMBEDDING_MODEL=all-MiniLM-L6-v2  （本地运行，无需 API Key）
# RAG_CHUNK_SIZE=512
# RAG_TOP_K=5

# ---------- 语音面试（可选）----------
# 阿里云 DashScope（语音识别 & 合成）
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# ASR_PROVIDER=dashscope
# TTS_PROVIDER=dashscope

# ---------- 面试配置 ----------
# MAX_MAIN_QUESTIONS=5
# MAX_FOLLOWUPS_PER_QUESTION=3
# PASS_SCORE_THRESHOLD=70.0
